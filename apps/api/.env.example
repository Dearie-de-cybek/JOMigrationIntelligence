# Copy to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (Prisma). No Docker in this project - get one instantly,
# no signup required, at https://pg.new (or run the claimable-postgres skill), or point
# this at any Postgres you already have.
DATABASE_URL=postgresql://user:password@host:5432/jo_migration_intelligence

NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Generate real secrets before anything but local dev, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=dev-only-change-me-cookie-secret

# Seed script creates one Super Admin on first run with these credentials (dev only):
SEED_SUPER_ADMIN_EMAIL=admin@joeducationconsultant.com.ng
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
